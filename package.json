{
  "name": "tuxevil-benchmark",
  "version": "0.1.0",
  "private": true,
  "description": "tuxevil Benchmark: local language-model benchmarking and quality-evaluation workspace. Runs the same scenario against one or more Ollama models, captures telemetry, and optionally evaluates answers with an OpenAI-compatible judge.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tuxevil/tuxevil-benchmark.git"
  },
  "homepage": "https://tuxevil-benchmark.tuxevil.com",
  "bugs": {
    "url": "https://github.com/tuxevil/tuxevil-benchmark/issues"
  },
  "keywords": [
    "llm",
    "benchmark",
    "ollama",
    "evaluation",
    "slm",
    "nextjs"
  ],
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "landing"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:dev": "PLAYWRIGHT_DEV=1 playwright test",
    "db:migrate": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f db/schema.sql",
    "worker": "tsx src/worker.ts",
    "mcp": "tsx src/mcp-server.ts",
    "landing:export": "tsx scripts/export-public-snapshot.ts",
    "landing:build": "npm run landing:export && npm run --prefix landing build",
    "landing:dev": "npm run --prefix landing dev"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@next/env": "16.2.12",
    "better-sqlite3": "^13.0.2",
    "bullmq": "6.0.6",
    "ioredis": "^6.0.0",
    "next": "16.2.12",
    "postgres": "3.4.7",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "24.3.0",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "eslint": "9.35.0",
    "eslint-config-next": "16.2.12",
    "tsx": "4.23.5",
    "typescript": "5.9.2",
    "vitest": "3.2.7"
  },
  "overrides": {
    "postcss": "^8.5.25",
    "sharp": "^0.35.3"
  }
}
