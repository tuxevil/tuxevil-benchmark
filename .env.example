# Application
APP_URL=http://localhost:3000

# MCP server (agent integration)
MCP_PORT=3001
MCP_HOST=0.0.0.0

# Optional defaults for the local services
# Leave OLLAMA_URL unset (empty) when the Ollama URL is saved in the app settings:
# /api/ollama/models prefers OLLAMA_URL over the saved settings URL, so setting it
# here shadows the settings value and lists the wrong models.
OLLAMA_URL=
ALLOWED_OLLAMA_HOSTS=
EVALUATOR_BASE_URL=
EVALUATOR_API_KEY=
EVALUATOR_MODEL=
APP_ENCRYPTION_KEY=

# SQLite database path (local mode only, ignored when DATABASE_URL is set)
# Existing checkouts with the legacy compare.db are auto-detected when this is unset.
SQLITE_PATH=./tuxevil-benchmark.db

# Durable mode: configure both DATABASE_URL and REDIS_URL
DATABASE_URL=
REDIS_URL=
POSTGRES_PASSWORD=
REDIS_PASSWORD=
POSTGRES_PORT=55432
BENCHMARK_CONCURRENCY=1
BENCHMARK_MODEL_CONCURRENCY=1

# Strata endpoint fallback (normally saved through Settings)
STRATA_URL=
# OpenAI-compatible inference deadline, in milliseconds
BENCHMARK_INFERENCE_TIMEOUT_MS=120000
# Local, private backup directory
RESULT_BACKUP_DIR=.backups/results
# JSON map: inference origin -> HTTP telemetry URL and optional token; keep private
BENCHMARK_RESOURCE_TARGETS={}

# Optional MQTT bridge (use a separate private environment file in deployments)
RESOURCE_MQTT_HOST=
RESOURCE_MQTT_PORT=1883
RESOURCE_MQTT_USER=
RESOURCE_MQTT_PASSWORD=
RESOURCE_MQTT_GPU_TOPIC=benchmark/host/gpu/attributes
RESOURCE_MQTT_PROCESS_TOPIC=benchmark/host/processes/attributes
RESOURCE_MQTT_PROCESS_NAME=llama-server
RESOURCE_MQTT_MAX_AGE_SECONDS=25
RESOURCE_COLLECTOR_TOKEN=
RESOURCE_COLLECTOR_PORT=9109
# Optional physical-resource grouping: inference origins mapped to stable resource IDs.
# Default is conservative: all ports on the same hostname share one resource.
BENCHMARK_RESOURCE_GROUPS={}

# Private administration: require HTTPS at the reverse proxy.
BENCHMARK_ADMIN_USER=
BENCHMARK_ADMIN_PASSWORD=
# Explicit public model names, comma separated. Empty publishes nothing.
BENCHMARK_PUBLIC_MODELS=
BENCHMARK_PUBLIC_MODEL_ALIASES={}
