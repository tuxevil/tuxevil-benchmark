# Application
APP_URL=http://localhost:3000

# MCP server (agent integration)
MCP_PORT=3001
MCP_HOST=0.0.0.0

# Optional defaults for the local services
# Leave OLLAMA_URL unset (empty) when the Ollama URL is saved in the app settings:
# /api/ollama/models prefers OLLAMA_URL over the saved settings URL, so setting it
# here shadows the settings value and lists the wrong models.
OLLAMA_URL=
ALLOWED_OLLAMA_HOSTS=
EVALUATOR_BASE_URL=
EVALUATOR_API_KEY=
EVALUATOR_MODEL=
APP_ENCRYPTION_KEY=

# SQLite database path (local mode only, ignored when DATABASE_URL is set)
# Existing checkouts with the legacy compare.db are auto-detected when this is unset.
SQLITE_PATH=./tuxevil-benchmark.db

# Reserved for the persistent worker implementation
DATABASE_URL=
REDIS_URL=
POSTGRES_PASSWORD=local-development-only
REDIS_PASSWORD=local-development-only
POSTGRES_PORT=55432
BENCHMARK_CONCURRENCY=1
BENCHMARK_MODEL_CONCURRENCY=1
